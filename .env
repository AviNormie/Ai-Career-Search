# .env - configuration for removing .DS_Store files on macOS
# Load with: export $(grep -v '^#' .env | xargs) or use a dotenv loader in your script

REMOVE_DSSTORE=true
DRY_RUN=false

# Path to start scanning (use $HOME or absolute path)
START_PATH="$HOME"

# Exclude paths (regex used with grep -E or perl-compatible tools)
EXCLUDE_PATTERNS="(^/Volumes|/\.git/|/node_modules/|/\.Trash/)"

# Find options (script should use these with `find`)
FIND_PATTERN=".DS_Store"
FIND_OPTIONS="-type f -name $FIND_PATTERN -print0"

# Log file for deletions
LOG_FILE="$HOME/dsstore_cleanup.log"

# Optional cron schedule (e.g. daily at 3:00 AM)
CRON_SCHEDULE="0 3 * * *"

# Safety limit to avoid mass-deleting accidentally
MAX_DELETE=1000